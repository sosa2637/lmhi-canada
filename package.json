{
  "name": "lmhi-canada",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:password": "node scripts/password.mjs",
    "test": "node --test tests/*.test.mjs",
    "uploads:cleanup": "node --env-file=.env.local scripts/cleanup-uploads.mjs",
    "format": "prettier --write app components lib scripts tests *.json *.ts *.md"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@vercel/blob": "^2.0.0",
    "jose": "^6.0.0",
    "lucide-react": "1.31.0",
    "next": "^16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
